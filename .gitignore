.mypy_cache/
.pytype/

# Jupyter
.ipynb_checkpoints/

# DeepSteer outputs - large logs and OS files excluded, data tracked
outputs/*.log
outputs/.DS_Store
# Large, reproducible activation caches (results JSON are kept; *_directions.npz are not matched)
**/*_activations.npz
# Phase 2 pipeline per-checkpoint direction caches (~180MB across 25 states,
# regenerable via pipeline_study.py; the results JSON hold all metrics).
papers/5_moral_alignment/outputs/pipeline/*/probe_directions.npz

# Working artifacts — never committed (audit reports, fix logs).
**/bib_audit_report.md
**/FIXLOG.md

# RunPod VALIDATE smoke + local self-transfer scratch (regenerable, not results).
papers/*/outputs/_validate_*/
papers/*/outputs/*_selftransfer/

# Ablation-resistance (ex-Paper 6, merged into Paper 5) model weight blobs
# (regenerable; result JSON + adapter configs ARE tracked, weights are not —
# LoRA adapters ~40MB each, merged/ablated ~14GB).
papers/5_moral_alignment/outputs/**/*.safetensors
papers/5_moral_alignment/outputs/**/merged_model/
papers/5_moral_alignment/outputs/**/ablated_model/
papers/5_moral_alignment/outputs/**/_merged/

# SAE artifacts (large binary files)
**/sae_activation_cache.pt
**/sae_layer*.pt

# Paper PDFs — tracked so collaborators can read without rebuilding.

# Downloaded caches (Gutenberg texts, etc.)
.cache/

# Environment and secrets
.env
*.pem

# Coding agents
.claude

# Generated arXiv submission bundles and metadata
/arxiv_*.tar.gz
/arxiv_*.md

# Large intermediate activation caches (reproducible via phase_c1_cache_activations.py)
papers/1_accuracy_vs_fragility/outputs/phase_c1_acts/
papers/1_accuracy_vs_fragility/outputs/phase_c4_comp_acts/
