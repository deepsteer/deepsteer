# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
/build/                 # Python `build/` only at project root (paper LaTeX build dirs are tracked)
eggs/
*.whl

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/
.pytype/

# Jupyter
.ipynb_checkpoints/

# DeepSteer outputs - large logs and OS files excluded, data tracked
outputs/*.log
outputs/.DS_Store
# Large, reproducible activation caches (results JSON are kept; *_directions.npz are not matched)
**/*_activations.npz
# Phase 2 pipeline per-checkpoint direction caches (~180MB across 25 states,
# regenerable via pipeline_study.py; the results JSON hold all metrics).
papers/5_moral_alignment/outputs/pipeline/*/probe_directions.npz

# Working artifacts — never committed (audit reports, fix logs).
**/bib_audit_report.md
**/FIXLOG.md

# RunPod VALIDATE smoke + local self-transfer scratch (regenerable, not results).
papers/*/outputs/_validate_*/
papers/*/outputs/*_selftransfer/

# Ablation-resistance (ex-Paper 6, merged into Paper 5) model weight blobs
# (regenerable; result JSON + adapter configs ARE tracked, weights are not —
# LoRA adapters ~40MB each, merged/ablated ~14GB).
papers/5_moral_alignment/outputs/**/*.safetensors
papers/5_moral_alignment/outputs/**/merged_model/
papers/5_moral_alignment/outputs/**/ablated_model/
papers/5_moral_alignment/outputs/**/_merged/
# Forced-coupling Stage 1/2 adapter dirs: weights ignored above; the remaining
# tokenizer.json (~7MB) + adapter_config copies are regenerable and redundant with
# the committed stage1_trajectory.json / stage2_a3.json results.
papers/5_moral_alignment/outputs/intervention_stage1/**/adapter/
papers/5_moral_alignment/outputs/intervention_stage2/**/adapter/

# Paper 6 (cross-model) — Heretic-ablated model weight blobs are regenerable
# (~14GB each); the small direction npz caches + decomposition result JSON ARE
# tracked so the decomposition re-runs locally with no GPU.
papers/6_cross_model/outputs/**/*.safetensors
papers/6_cross_model/outputs/**/ablated_model/
papers/6_cross_model/outputs/**/*.bin
# Transient per-model exp1 figures (written to a shared dir, overwritten by each
# model; not a Paper 6 deliverable — phase1_cross_model.* is). Regenerable.
papers/6_cross_model/outputs/figures/

# SAE artifacts (large binary files)
**/sae_activation_cache.pt
**/sae_layer*.pt

# Paper PDFs — tracked so collaborators can read without rebuilding.

# Downloaded caches (Gutenberg texts, etc.)
.cache/

# Environment and secrets
.env
*.pem

# Coding agents
.claude

# Generated arXiv submission bundles and metadata
/arxiv_*.tar.gz
/arxiv_*.md

# Large intermediate activation caches (reproducible via phase_c1_cache_activations.py)
papers/1_accuracy_vs_fragility/outputs/phase_c1_acts/
papers/1_accuracy_vs_fragility/outputs/phase_c4_comp_acts/

# Direction 1: pilot/working generation + audit artifacts (regenerable)
papers/d1_moral_subspace/outputs/
# Direction 2: per-model session outputs (regenerable; numbers of record go in RESULTS.md)
papers/d2_decision_coupling/outputs/
