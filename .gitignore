# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
/build/                 # Python `build/` only at project root (paper LaTeX build dirs are tracked)
eggs/
*.whl

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/
.pytype/

# Jupyter
.ipynb_checkpoints/

# DeepSteer outputs - large logs and OS files excluded, data tracked
outputs/*.log
outputs/.DS_Store

# SAE artifacts (large binary files)
**/sae_activation_cache.pt
**/sae_layer*.pt

# Paper PDFs — tracked so collaborators can read without rebuilding.

# Downloaded caches (Gutenberg texts, etc.)
.cache/

# Environment and secrets
.env
*.pem

# Coding agents
.claude
